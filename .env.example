# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (Local - FREE)
MONGODB_URI=mongodb://localhost:27017/evitrack

# JWT Secret (Change this to a random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Blockchain Configuration
# Option 1: Ganache (Local Blockchain - FREE, Recommended for Development)
ETHEREUM_RPC_URL=http://127.0.0.1:8545
NETWORK_NAME=ganache

# Option 2: Sepolia Testnet (FREE, Requires Internet)
# ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# NETWORK_NAME=sepolia

# Option 3: Simulation Mode (No Blockchain Needed - Perfect for Demos)
# Leave CONTRACT_ADDRESS and PRIVATE_KEY empty, or set DEMO_MODE=true
# DEMO_MODE=true

# Smart Contract Configuration (Get these after deploying contract)
CONTRACT_ADDRESS=
PRIVATE_KEY=

# File Upload Configuration
MAX_FILE_SIZE=524288000
UPLOAD_DIR=uploads/evidence

# Infura API Key (FREE - Get from https://infura.io/)
# Only needed if using Sepolia testnet
INFURA_API_KEY=
